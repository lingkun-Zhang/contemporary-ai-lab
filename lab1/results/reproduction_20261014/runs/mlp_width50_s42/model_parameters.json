{
  "activation": "relu",
  "alpha": 0.005,
  "batch_size": 64,
  "beta_1": 0.9,
  "beta_2": 0.999,
  "early_stopping": false,
  "epsilon": 1e-08,
  "hidden_layer_sizes": [
    50
  ],
  "learning_rate": "constant",
  "learning_rate_init": 0.0001,
  "max_fun": 15000,
  "max_iter": 200,
  "momentum": 0.9,
  "n_iter_no_change": 10,
  "nesterovs_momentum": true,
  "power_t": 0.5,
  "random_state": "persistent numpy.random.RandomState(seed in run_config)",
  "shuffle": true,
  "solver": "adam",
  "tol": 0.0001,
  "validation_fraction": 0.1,
  "verbose": false,
  "warm_start": false
}